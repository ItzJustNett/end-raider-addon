{
  "schemaVersion": 1,
  "id": "end-raider",
  "version": "${version}",
  "name": "End Raider",
  "description": "Meteor addon that raids the End with Baritone: bridges between islands, farms endermen when the pickaxe is low and boxes in near loot.",
  "authors": ["ItzJustNett"],
  "contact": { "sources": "https://github.com/ItzJustNett/end-raider-addon" },
  "icon": "assets/endraider/icon.png",
  "environment": "client",
  "entrypoints": { "meteor": ["com.endraider.EndRaiderAddon"] },
  "custom": {
    "meteor-client:color": "160,60,220",
    "modmenu": { "parent": { "id": "meteor-client" } }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
